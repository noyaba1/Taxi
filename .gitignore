# --- Never commit the heavy data (1.9 GB) or generated artifacts ---
train.csv/
data/raw/
data/sample/
data/processed/
*.parquet/
outputs/maps/
outputs/routes/
outputs/logs/
# Generated statistic reports (keep the folder placeholder, ignore contents)
outputs/statistics/*
!outputs/statistics/.gitkeep

# Raw lecturer files (keep them locally, not in git)
*.csv

# --- Python / Spark cruft ---
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
spark-warehouse/
metastore_db/
derby.log

# --- Spark local scratch (shuffle spill; tens of GB during a mid-scale run) ---
.spark-tmp/
.pytest_cache/

# --- The lecturer's dataset folder (as shipped by UCI) ---
taxi+service+trajectory+prediction+challenge+ecml+pkdd+2015/

# Machine-local Claude Code settings (permissions differ per developer)
.claude/settings.local.json

# Build artifact from scripts/dataproc_submit.sh
src.zip
# Cloud outputs downloaded for verification (regenerable from GCS)
cloud_outputs/

# Generated deck (rebuild: python scripts/build_deck_charts.py && python scripts/build_deck.py)
build/
